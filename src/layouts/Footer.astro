---
import { SITE_TITLE } from "@/consts";
import { ThemeToggle } from "@/features/theme/components/theme-toggle";
import { messages } from "@/lib/i18n/messages";
import { localeFromPath, localizedPath } from "@/lib/i18n/ui";

const locale = localeFromPath(Astro.url.pathname);
const ui = messages[locale];
const about = localizedPath("/about/", locale);
const other = locale === "en" ? "ko" : "en";
---

<footer class="site-footer">
	<span>&copy; {new Date().getFullYear()} {SITE_TITLE}</span>
	<div class="footer-actions">
		<nav aria-label={ui.footer}>
			<a
				href={about}
				aria-current={Astro.url.pathname === about ? "page" : undefined}
				>{ui.about}</a
			>
			<a href={localizedPath("/rss.xml", locale)}>RSS</a>
			<a
				href={localizedPath(Astro.url.pathname, other)}
				lang={other}
				hreflang={other}
				aria-label={`${ui.language}: ${other === "ko" ? "한국어" : "English"}`}
				>{other === "ko" ? "한국어" : "English"}</a
			>
		</nav>
		<ThemeToggle
			label={ui.theme}
			darkLabel={ui.themeDark}
			lightLabel={ui.themeLight}
		/>
	</div>
</footer>
